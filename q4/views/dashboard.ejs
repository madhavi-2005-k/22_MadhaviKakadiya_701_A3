<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERP Admin Panel - Employees</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Top Navigation -->
  <nav class="navbar">
    <h1>ERP System - Admin Panel</h1>
    <div class="nav-links">
      <span>Logged in as: <strong><%= adminUser %></strong></span>
      <a href="/logout" class="btn btn-danger btn-sm" style="color: white; margin-left: 15px;">Logout</a>
    </div>
  </nav>

  <div class="container">

    <!-- Flash Notifications -->
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card">
      <div class="header-row">
        <h2>Employee Management (<%= employees.length %>)</h2>
        <a href="/employees/add" class="btn btn-success">+ Add New Employee</a>
      </div>

      <% if (employees.length === 0) { %>
        <p style="text-align: center; color: #7f8c8d; padding: 30px;">
          No employee records found. Click <strong>"+ Add New Employee"</strong> to add your first employee.
        </p>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Emp ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Basic (₹)</th>
                <th>HRA (₹)</th>
                <th>DA (₹)</th>
                <th>Deductions (₹)</th>
                <th>Net Salary (₹)</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% employees.forEach(function(emp) { %>
                <tr>
                  <td><strong><%= emp.empid %></strong></td>
                  <td><%= emp.name %></td>
                  <td><%= emp.email %></td>
                  <td><%= emp.department %></td>
                  <td><%= emp.basicSalary.toLocaleString() %></td>
                  <td><%= emp.hra.toLocaleString() %></td>
                  <td><%= emp.da.toLocaleString() %></td>
                  <td><%= emp.deductions.toLocaleString() %></td>
                  <td><strong>₹<%= emp.netSalary.toLocaleString() %></strong></td>
                  <td>
                    <a href="/employees/edit/<%= emp._id %>" class="btn btn-primary btn-sm">Edit</a>
                    <a 
                      href="/employees/delete/<%= emp._id %>" 
                      class="btn btn-danger btn-sm"
                      onclick="return confirm('Are you sure you want to delete <%= emp.name %> (<%= emp.empid %>)?');"
                    >
                      Delete
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>

</body>
</html>
