<!DOCTYPE html>
<html>

<head>

    <title>User Registration</title>

    <style>

        body {
            font-family: Arial;
            background-color: #f2f2f2;
        }

        .container {
            width: 600px;
            margin: 30px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        h1 {
            text-align: center;
        }

        label {
            font-weight: bold;
        }

        input[type="text"],
        input[type="password"],
        input[type="email"] {
            width: 95%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        input[type="file"] {
            margin-top: 8px;
            margin-bottom: 15px;
        }

        .error {
            background-color: #ffd6d6;
            color: red;
            padding: 10px;
            margin-bottom: 5px;
        }

        .submit {
            background-color: #007bff;
            color: white;
            padding: 12px 25px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

    </style>

</head>

<body>

<div class="container">

    <h1>User Registration Form</h1>

    <!-- Display Errors -->

    <% if (errors && errors.length > 0) { %>

        <% errors.forEach(function(error) { %>

            <div class="error">

                <%= error.msg || error %>

            </div>

        <% }); %>

    <% } %>

    <form
        action="/register"
        method="POST"
        enctype="multipart/form-data"
    >

        <!-- Username -->

        <label>Username:</label>

        <input
            type="text"
            name="username"
            value="<%= oldData.username || '' %>"
        >

        <!-- Password -->

        <label>Password:</label>

        <input
            type="password"
            name="password"
        >

        <!-- Confirm Password -->

        <label>Confirm Password:</label>

        <input
            type="password"
            name="confirmPassword"
        >

        <!-- Email -->

        <label>Email:</label>

        <input
            type="email"
            name="email"
            value="<%= oldData.email || '' %>"
        >

        <!-- Gender -->

        <label>Gender:</label>
        <br>

        <input
            type="radio"
            name="gender"
            value="Male"
            <%= oldData.gender === "Male" ? "checked" : "" %>
        >

        Male

        <input
            type="radio"
            name="gender"
            value="Female"
            <%= oldData.gender === "Female" ? "checked" : "" %>
        >

        Female

        <input
            type="radio"
            name="gender"
            value="Other"
            <%= oldData.gender === "Other" ? "checked" : "" %>
        >

        Other

        <br><br>

        <!-- Hobbies -->

        <label>Hobbies:</label>
        <br>

        <input
            type="checkbox"
            name="hobbies"
            value="Reading"
            <%= oldData.hobbies && oldData.hobbies.includes("Reading") ? "checked" : "" %>
        >

        Reading

        <input
            type="checkbox"
            name="hobbies"
            value="Music"
            <%= oldData.hobbies && oldData.hobbies.includes("Music") ? "checked" : "" %>
        >

        Music

        <input
            type="checkbox"
            name="hobbies"
            value="Sports"
            <%= oldData.hobbies && oldData.hobbies.includes("Sports") ? "checked" : "" %>
        >

        Sports

        <input
            type="checkbox"
            name="hobbies"
            value="Travel"
            <%= oldData.hobbies && oldData.hobbies.includes("Travel") ? "checked" : "" %>
        >

        Travel

        <br><br>

        <!-- Profile Picture -->

        <label>Upload Profile Picture:</label>

        <br>

        <input
            type="file"
            name="profilePic"
            accept=".jpg,.jpeg,.png"
        >

        <br>

        <!-- Other Pictures -->

        <label>Upload Other Pictures:</label>

        <br>

        <input
            type="file"
            name="otherPics"
            accept=".jpg,.jpeg,.png"
            multiple
        >

        <br>

        <small>
            You can upload maximum 5 images.
            Each image must be below 2MB.
        </small>

        <br><br>

        <button
            type="submit"
            class="submit"
        >
            Register
        </button>

    </form>

</div>

</body>

</html>